{
  "name": "label-maker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WYSIWYG thermal label editor and direct printer for iDPRT SP410 and SP310",
  "author": "dwyerwilliam",
  "license": "MIT",
  "main": "dist-electron/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/copy-pdfjs-assets.mjs && vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:ui": "playwright test --config=playwright.config.ts",
    "build:native": "node scripts/build-native.mjs",
    "build:app": "node scripts/copy-pdfjs-assets.mjs && tsc --noEmit && vite build",
    "pretest:electron": "node node_modules/electron/install.js",
    "test:electron": "playwright test --config=playwright.electron.config.ts",
    "package:win": "npm run build:native && npm run build:app && electron-builder --win --x64",
    "package:mac": "npm run build:native && npm run build:app && electron-builder --mac",
    "test:packaged": "node scripts/packaged-smoke.mjs",
    "fixtures:shipping": "node scripts/make-shipping-fixtures.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pdf-lib": "1.17.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "^11.0.1"
    },
    "@electron/universal": {
      "minimatch": "^11.0.1"
    }
  },
  "build": {
    "appId": "com.labelmaker.app",
    "productName": "Label Maker",
    "directories": {
      "output": "releases/artifacts"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "native-bin/${platform}",
        "to": "native-bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "win": {
      "icon": "public/labelmaker-icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LabelMaker-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Label Maker"
    },
    "mac": {
      "icon": "public/labelmaker-icon.png",
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "artifactName": "LabelMaker-${version}-${arch}.${ext}"
    },
    "publish": null
  }
}
