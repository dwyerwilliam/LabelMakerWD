{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "playwright.config.ts", "playwright.electron.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "dist-electron", "releases", "worktrees", ".claude"]
}
